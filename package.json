{
  "name": "nimbus-markdown",
  "version": "0.0.0",
  "private": true,
  "description": "Nimbus Markdown / Browser Extension",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "test:ci": "bun test",
    "build": "bun scripts/build.mjs chrome",
    "build:dist": "bun scripts/build.mjs chrome",
    "build:dist:firefox": "bun scripts/build.mjs firefox",
    "build:zip": "bun scripts/build.mjs firefox zip && bun scripts/build.mjs chrome zip",
    "build:themes": "bun scripts/build.mjs chrome themes",
    "build:store": "bun scripts/store-assets.mjs",
    "build:site": "bun scripts/build.mjs chrome && bun scripts/site.mjs",
    "build:vscode": "bun scripts/vscode.mjs",
    "build:vsix": "bun scripts/vscode.mjs pack"
  },
  "dependencies": {
    "@material/button": "0.37.1",
    "@material/ripple": "0.37.1",
    "@material/switch": "0.36.1",
    "@material/tabs": "0.37.1",
    "@material/textfield": "0.37.1",
    "@panzoom/panzoom": "4.6.2",
    "bootstrap": "5.3.8",
    "cleanrmd": "github:gadenbuie/cleanrmd#v0.1.0",
    "csso": "5.0.5",
    "fflate": "0.8.3",
    "github-markdown-css": "5.9.0",
    "github-slugger": "2.0.0",
    "markdown-it": "15.0.3",
    "markdown-it-abbr": "2.0.0",
    "markdown-it-anchor": "10.0.0",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-cjk-breaks": "2.0.1",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-ins": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "mathjax": "3.2.2",
    "mithril": "1.1.7",
    "ondine": "^0.0.3",
    "prismjs": "1.30.0",
    "sass": "1.106.1",
    "terser": "5.51.2"
  },
  "devDependencies": {
    "@tracewayapp/frontend": "^1.2.1",
    "@vscode/vsce": "4.1.0",
    "playwright": "1.64.1"
