{
  "manifest_version": 3,
  "name"            : "Nimbus Markdown",
  "version"         : "0.0",
  "description"     : "Beautiful Markdown viewer for Chrome. Preview local and online .md files with Mermaid diagrams, syntax highlighting, and themes.",

  "homepage_url": "https://github.com/dvgamerr-app/nimbus-markdown",

  "icons": {
    "16" : "/icons/default/16x16.png",
    "19" : "/icons/default/19x19.png",
    "38" : "/icons/default/38x38.png",
    "48" : "/icons/default/48x48.png",
    "128": "/icons/default/128x128.png"
  },

  "action": {
    "default_icon": {
      "16" : "/icons/default/16x16.png",
      "19" : "/icons/default/19x19.png",
      "38" : "/icons/default/38x38.png",
      "48" : "/icons/default/48x48.png",
      "128" : "/icons/default/128x128.png"
    },
    "default_title": "Nimbus Markdown",
    "default_popup": "/popup/index.html"
  },

  "background" : {
    "scripts": [
      "/vendor/markdown-it.min.js",
      "/vendor/ondine.min.js",

      "/background/compilers/markdown-it.js",

      "/background/storage.js",
      "/background/webrequest.js",
      "/background/detect.js",
      "/background/inject.js",
      "/background/messages.js",
      "/background/mathjax.js",
      "/background/xhr.js",
      "/background/ondine.js",
      "/background/icon.js",

      "/background/index.js"
    ]
  },

  "options_ui": {
    "page": "/options/index.html",
    "browser_style": false
  },

  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "/content/anchor.svg",
        "/icons/default/16x16.png",
        "/icons/dark/16x16.png",
        "/icons/light/16x16.png",
        "/themes/*",
        "/vendor/mathjax/fonts/*",
        "/vendor/prism.min.css",
        "/vendor/prism-okaidia.min.css"
      ]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },

  "permissions": [
    "storage",
    "scripting"
  ],

  "host_permissions": [
    "file:///*"
  ],

  "optional_permissions": [
    "webRequest",
    "*://*/"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "nimbus-markdown@dvgamerr-app.github.io",
      "strict_min_version": "110.0"
    }
  }
}
